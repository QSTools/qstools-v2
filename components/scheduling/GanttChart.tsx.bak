"use client";

import type {
  GanttRow,
  ScheduleTask,
} from "@/lib/calculations/schedulingCalculations";

type GanttChartProps = {
  gantt: {
    visible_rows: GanttRow[];
    timeline_start: string;
    timeline_end: string;
    timeline_days: number;
    view_mode: "day" | "week" | "month";
    warnings: string[];
  };
  actions?: {
    updateTask?: (task_id: string, patch: Partial<ScheduleTask>) => void;
    deleteTask?: (task_id: string) => void;
    moveTask?: (task_id: string, direction: "up" | "down") => void;
  };
};

type CalendarLabel = {
  label: string;
  left_percent: number;
};

type DayLabel = {
  label: string;
  left_percent: number;
  is_week_start: boolean;
};

const MS_PER_DAY = 24 * 60 * 60 * 1000;

function parseDate(value: string): Date {
  return new Date(`${value}T00:00:00`);
}

function addDays(date: Date, days: number): Date {
  const next = new Date(date);
  next.setDate(next.getDate() + days);
  return next;
}

function formatShortDate(date: Date): string {
  return date.toLocaleDateString("en-NZ", {
    day: "numeric",
    month: "short",
  });
}

function formatRowDate(value?: string): string {
  if (!value) return "-";

  const date = parseDate(value);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleDateString("en-NZ", {
    day: "numeric",
    month: "short",
    year: "2-digit",
  });
}

function getDayLetter(date: Date): string {
  const day = date.getDay();

  if (day === 0) return "S";
  if (day === 1) return "M";
  if (day === 2) return "T";
  if (day === 3) return "W";
  if (day === 4) return "T";
  if (day === 5) return "F";
  return "S";
}

function getTypeLabel(row: GanttRow): string {
  if (row.row_type === "milestone") return "M";
  if (row.row_type === "project") return "S";
  return "T";
}

function getCalendarLabels(
  timeline_start: string,
  timeline_days: number,
  view_mode: "day" | "week" | "month"
): CalendarLabel[] {
  const start = parseDate(timeline_start);
  const labels: CalendarLabel[] = [];

  const interval = view_mode === "month" ? 30 : 7;

  for (let day = 0; day <= timeline_days; day += interval) {
    const current = addDays(start, day);

    labels.push({
      label: formatShortDate(current),
      left_percent: (day / timeline_days) * 100,
    });
  }

  return labels;
}

function getDayLabels(
  timeline_start: string,
  timeline_days: number,
  view_mode: "day" | "week" | "month"
): DayLabel[] {
  const start = parseDate(timeline_start);
  const labels: DayLabel[] = [];

  const interval = view_mode === "month" ? 7 : 1;

  for (let day = 0; day <= timeline_days; day += interval) {
    const current = addDays(start, day);

    labels.push({
      label:
        view_mode === "month"
          ? formatShortDate(current)
          : getDayLetter(current),
      left_percent: (day / timeline_days) * 100,
      is_week_start: current.getDay() === 1,
    });
  }

  return labels;
}

function getRowClass(row: GanttRow): string {
  if (row.row_type === "project") return "is-project-row";
  if (row.row_type === "stage") return "is-stage-row";
  if (row.row_type === "milestone") return "is-milestone-row";
  return "";
}

function getBarClass(row: GanttRow, index: number): string {
  const base = ["schedule-bar"];

  if (row.row_type === "project") base.push("is-project-bar");
  if (row.row_type === "stage") base.push("is-stage-bar");
  if (index >= 15) base.push("is-future-bar");

  return base.join(" ");
}

export default function GanttChart({ gantt }: GanttChartProps) {
  const calendar_labels = getCalendarLabels(
    gantt.timeline_start,
    gantt.timeline_days,
    gantt.view_mode
  );

  const day_labels = getDayLabels(
    gantt.timeline_start,
    gantt.timeline_days,
    gantt.view_mode
  );

  return (
    <section className="schedule-board">
      <div className="schedule-board-scroll">
        <div className="schedule-grid">
          <div className="schedule-left-header">
            <div>ID</div>
            <div>S ID</div>
            <div>R ID</div>
            <div>Type</div>
            <div>Description</div>
            <div>Role</div>
            <div>Team</div>
            <div>Work Days</div>
            <div>Start</div>
            <div>End</div>
          </div>

          <div className="schedule-right-header">
            <div className="schedule-calendar-dates">
              {calendar_labels.map((label) => (
                <span
                  key={`date-${label.label}-${label.left_percent}`}
                  className="schedule-calendar-date"
                  style={{ left: `${label.left_percent}%` }}
                >
                  {label.label}
                </span>
              ))}
            </div>

            <div className="schedule-calendar-days">
              {day_labels.map((label) => (
                <span
                  key={`day-${label.label}-${label.left_percent}`}
                  className={
                    label.is_week_start
                      ? "schedule-calendar-day is-week-start"
                      : "schedule-calendar-day"
                  }
                  style={{ left: `${label.left_percent}%` }}
                >
                  {label.label}
                </span>
              ))}
            </div>
          </div>

          {gantt.visible_rows.map((row, index) => {
            const row_class = getRowClass(row);
            const row_id = index + 1;

            return (
              <div className="schedule-row" key={row.task_id}>
                <div className={`schedule-left-row ${row_class}`}>
                  <div className="schedule-cell schedule-id-cell">{row_id}</div>
                  <div className="schedule-cell schedule-sub-id-cell">1</div>
                  <div className="schedule-cell schedule-ref-id-cell">1</div>
                  <div className="schedule-cell schedule-type-cell">
                    {getTypeLabel(row)}
                  </div>
                  <div className="schedule-cell schedule-description-cell">
                    {row.task_name || "Untitled row"}
                  </div>
                  <div className="schedule-cell schedule-role-cell">PM</div>
                  <div className="schedule-cell schedule-team-cell">
                    Paul Davis
                  </div>
                  <div className="schedule-cell schedule-days-cell">
                    {row.duration_days}
                  </div>
                  <div className="schedule-cell schedule-date-cell">
                    {formatRowDate(row.start_date)}
                  </div>
                  <div className="schedule-cell schedule-date-cell">
                    {formatRowDate(row.end_date || row.start_date)}
                  </div>
                </div>

                <div className={`schedule-gantt-row ${row_class}`}>
                  {day_labels.map((label) => (
                    <span
                      key={`grid-${row.task_id}-${label.left_percent}`}
                      className={
                        label.is_week_start
                          ? "schedule-grid-line is-week-start"
                          : "schedule-grid-line"
                      }
                      style={{ left: `${label.left_percent}%` }}
                    />
                  ))}

                  {row.is_milestone ? (
                    <div
                      className="schedule-milestone"
                      style={{ left: `${row.left_percent}%` }}
                      title={row.task_name}
                    />
                  ) : (
                    <div
                      className={getBarClass(row, index)}
                      style={{
                        left: `${row.left_percent}%`,
                        width: `${row.width_percent}%`,
                      }}
                      title={row.task_name}
                    />
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  );
}